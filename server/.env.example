DATABASE_URL=postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
FRONTEND_URL=http://localhost:3000
JWT_SECRET=replace-with-at-least-32-random-characters
FACEIT_API_KEY=replace-with-faceit-api-key
HENRIKDEV_API_KEY=replace-with-henrikdev-api-key
DOTA_API_KEY=replace-with-dota-api-key-if-used
STRATZ_API_KEY=replace-with-stratz-api-key-if-used
# Optional: number of reverse proxies in front of the server (default 1)
TRUST_PROXY_HOPS=1
